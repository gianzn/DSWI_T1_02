@model IEnumerable<DSWI_T1_01.Models.Producto>

@{
    ViewData["Title"] = "Mantenimiento de Productos";
}

<h2 class="mb-4">Mantenimiento de Productos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <h5>Registrar nuevo producto</h5>
    </div>

    <div class="card-body">
        <form asp-controller="Productos"
              asp-action="Crear"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input type="text"
                       name="nombre"
                       class="form-control"
                       maxlength="100"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Categoría</label>
                <input type="text"
                       name="categoria"
                       class="form-control"
                       maxlength="50"
                       required />
            </div>

            <button type="submit" class="btn btn-primary">
                Registrar producto
            </button>
        </form>
    </div>
</div>

<h4>Listado de productos</h4>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Editar producto</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.ProductoId</td>
                <td>@producto.Nombre</td>
                <td>@producto.Categoria</td>
                <td>
                    <form asp-controller="Productos"
                          asp-action="Editar"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="productoId"
                               value="@producto.ProductoId" />

                        <input type="text"
                               name="nombre"
                               value="@producto.Nombre"
                               class="form-control mb-2"
                               maxlength="100"
                               required />

                        <input type="text"
                               name="categoria"
                               value="@producto.Categoria"
                               class="form-control mb-2"
                               maxlength="50"
                               required />

                        <button type="submit"
                                class="btn btn-warning btn-sm">
                            Guardar cambios
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>